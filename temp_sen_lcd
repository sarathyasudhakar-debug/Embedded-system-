
 #include <xc.h>

#define _XTAL_FREQ 20000000

#pragma config FOSC = HS
#pragma config WDTE = OFF
#pragma config PWRTE = ON
#pragma config BOREN = ON
#pragma config LVP = OFF
#pragma config CPD = OFF
#pragma config WRT = OFF
#pragma config CP = OFF

#define RS RD0
#define EN RD2

void LCD_Enable(void)
{
    EN = 1;
    __delay_us(2);
    EN = 0;
    __delay_us(100);
}

void LCD_Send4Bit(unsigned char data)
{
    RD4 = (data >> 4) & 1;
    RD5 = (data >> 5) & 1;
    RD6 = (data >> 6) & 1;
    RD7 = (data >> 7) & 1;

    LCD_Enable();
}

void LCD_Command(unsigned char cmd)
{
    RS = 0;

    LCD_Send4Bit(cmd);
    LCD_Send4Bit(cmd << 4);

    __delay_ms(2);
}

void LCD_Char(unsigned char data)
{
    RS = 1;

    LCD_Send4Bit(data);
    LCD_Send4Bit(data << 4);

    __delay_us(100);
}

void LCD_String(const char *str)
{
    while(*str)
    {
        LCD_Char(*str++);
    }
}

void LCD_Init(void)
{
    TRISD = 0x00;

    RS = 0;
    EN = 0;

    __delay_ms(20);

    RD4 = 1;
    RD5 = 1;
    RD6 = 0;
    RD7 = 0;
    LCD_Enable();

    __delay_ms(5);

    LCD_Enable();
    __delay_us(150);

    LCD_Enable();

    RD4 = 0;
    RD5 = 1;
    RD6 = 0;
    RD7 = 0;
    LCD_Enable();

    LCD_Command(0x28);
    LCD_Command(0x0C);
    LCD_Command(0x06);
    LCD_Command(0x01);

    __delay_ms(2);
}

void ADC_Init(void)
{
    TRISA = 0xFF;

    ADCON1 = 0x80;
    ADCON0 = 0x41;     // ADC ON, AN0 selected
}

unsigned int ADC_Read(void)
{
    __delay_us(20);

    GO_nDONE = 1;

    while(GO_nDONE);

    return ((ADRESH << 8) | ADRESL);
}

void main(void)
{
    unsigned int adc;
    unsigned int temperature;

    ADC_Init();
    LCD_Init();

    while(1)
    {
        adc = ADC_Read();

        // LM35: 10mV per degree C
        // Vref = 5V
        temperature = ((unsigned long)adc * 500) / 1023;

        LCD_Command(0x80);
        LCD_String("TEMPERATURE:");

        LCD_Command(0xC0);

        LCD_Char((temperature / 100) + '0');
        LCD_Char(((temperature / 10) % 10) + '0');
        LCD_Char((temperature % 10) + '0');

        LCD_Char(0xDF);     // Degree symbol
        LCD_Char('C');

        __delay_ms(500);
    }
}
